# LLM (tool calling) and speech-to-text (Whisper), one free key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
STT_MODEL=whisper-large-v3-turbo

# Voice replies. With a key the app uses ElevenLabs (free plan: about 10,000 credits per month),
# otherwise it falls back to a free Edge neural voice. Check ElevenLabs' current terms before commercial use.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
# TTS_PROVIDER=edge          # force the free voice
# EDGE_VOICE=en-US-AriaNeural

# Semantic FAQ search needs `pip install sentence-transformers`; set to 0 to force keyword-only search.
# FAQ_EMBEDDINGS=auto
